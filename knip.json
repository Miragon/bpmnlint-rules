{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["src/rules/miragon/**/*.ts!", "test/**/*.spec.ts", "test/distro/*.{cjs,mjs}"],
      "project": ["src/**/*.ts", "test/**/*.{ts,cjs,mjs}"]
    },
    "docs": {
      "entry": ["scripts/*.mjs", ".vitepress/theme/*.data.ts"],
      "project": ["scripts/*.mjs", ".vitepress/**/*.{ts,mts,vue}"],
      "ignore": [".vitepress/miragon/**"],
      "ignoreDependencies": [
        "@braintree/sanitize-url",
        "cytoscape",
        "cytoscape-cose-bilkent",
        "dayjs",
        "debug"
      ]
    }
  }
}
