{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["src/rules/miragon/*.ts!", "test/**/*.spec.ts", "test/distro/*.cjs"],
      "project": ["src/**/*.ts", "test/**/*.{ts,cjs}"]
    },
    "docs": {
      "entry": ["scripts/*.mjs", ".vitepress/theme/*.data.ts"],
      "project": ["scripts/*.mjs", ".vitepress/**/*.{ts,mts,vue}"]
    }
  }
}
