{
  "name": "@miragon/bpmnlint-plugin-rules",
  "version": "0.16.0",
  "description": "A bpmnlint plugin bundling the standard structural rules, Camunda 7/8 deployability rules and Miragon BPMN conventions behind one resolver.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Miragon GmbH (https://miragon.io)",
  "keywords": [
    "bpmnlint",
    "bpmnlint-plugin",
    "bpmn",
    "bpmn.io",
    "camunda",
    "linter",
    "lint-rules",
    "miragon",
    "ai"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./rules/*": {
      "import": {
        "types": "./dist/rules/miragon/*.d.ts",
        "default": "./dist/rules/miragon/*.js"
      },
      "require": {
        "types": "./dist/rules/miragon/*.d.cts",
        "default": "./dist/rules/miragon/*.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "npm run build && vitest run --config vitest.bench.config.ts",
    "test:distro": "node test/distro/smoke.cjs",
    "lint": "eslint .",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs --output-type err",
    "lint:bpmn": "bpmnlint \"test/fixtures/valid/*.bpmn\"",
    "knip": "knip",
    "knip:production": "knip --production --strict",
    "knip:fix": "knip --fix",
    "docs:examples": "npm run examples --workspace docs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build",
    "docs:dev": "npm run build && npm run dev --workspace docs",
    "docs:build": "npm run build && npm run build --workspace docs"
  },
  "peerDependencies": {
    "bpmnlint": ">=11.14.0"
  },
  "dependencies": {
    "bpmnlint-plugin-camunda-compat": "2.61.1",
    "bpmnlint-utils": "1.1.1",
    "camunda-bpmn-moddle": "8.0.2",
    "zeebe-bpmn-moddle": "2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "bpmnlint": "11.15.0",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "knip": "6.41.0",
    "prettier": "3.9.10",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/bpmnlint-rules.git"
  },
  "bugs": {
    "url": "https://github.com/Miragon/bpmnlint-rules/issues"
  },
  "homepage": "https://miragon.github.io/bpmnlint-rules/",
  "workspaces": [
    "docs"
  ]
}
