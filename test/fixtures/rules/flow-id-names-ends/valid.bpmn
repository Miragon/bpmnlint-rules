<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_FlowIdNamesEnds" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="orderReview" isExecutable="true">
    <bpmn:startEvent id="startEvent_orderReceived" name="Order received">
      <bpmn:outgoing>flow_orderReceivedToReview</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="serviceTask_review" name="Review order">
      <bpmn:incoming>flow_orderReceivedToReview</bpmn:incoming>
      <bpmn:outgoing>flow_reviewToApproved</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endEvent_approved" name="Order approved">
      <bpmn:incoming>flow_reviewToApproved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_orderReceivedToReview" sourceRef="startEvent_orderReceived" targetRef="serviceTask_review" />
    <bpmn:sequenceFlow id="flow_reviewToApproved" sourceRef="serviceTask_review" targetRef="endEvent_approved" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="orderReview">
      <bpmndi:BPMNShape id="startEvent_orderReceived_di" bpmnElement="startEvent_orderReceived">
        <dc:Bounds x="160" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_review_di" bpmnElement="serviceTask_review">
        <dc:Bounds x="250" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_approved_di" bpmnElement="endEvent_approved">
        <dc:Bounds x="412" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_orderReceivedToReview_di" bpmnElement="flow_orderReceivedToReview">
        <di:waypoint x="196" y="120" />
        <di:waypoint x="250" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_reviewToApproved_di" bpmnElement="flow_reviewToApproved">
        <di:waypoint x="350" y="120" />
        <di:waypoint x="412" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
