<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_OrderPayment" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:message id="message_paymentReceived" name="paymentReceived" />
  <bpmn:process id="orderPayment" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="startEvent_orderPlaced" name="Order placed" camunda:asyncBefore="true">
      <bpmn:outgoing>flow_orderPlaced</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="userTask_sendInvoice" name="Send invoice" camunda:asyncAfter="true">
      <bpmn:incoming>flow_orderPlaced</bpmn:incoming>
      <bpmn:outgoing>flow_invoiceSent</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="gateway_paymentOutcome" name="Payment outcome?">
      <bpmn:incoming>flow_invoiceSent</bpmn:incoming>
      <bpmn:outgoing>flow_toPaymentReceived</bpmn:outgoing>
      <bpmn:outgoing>flow_toPaymentOverdue</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="event_paymentReceived" name="Payment received">
      <bpmn:incoming>flow_toPaymentReceived</bpmn:incoming>
      <bpmn:outgoing>flow_paymentReceived</bpmn:outgoing>
      <bpmn:messageEventDefinition id="messageEventDefinition_paymentReceived" messageRef="message_paymentReceived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="endEvent_orderPaid" name="Order paid">
      <bpmn:incoming>flow_paymentReceived</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="event_paymentOverdue" name="Payment overdue">
      <bpmn:incoming>flow_toPaymentOverdue</bpmn:incoming>
      <bpmn:outgoing>flow_paymentOverdue</bpmn:outgoing>
      <bpmn:timerEventDefinition id="timerEventDefinition_paymentOverdue">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="endEvent_orderCancelled" name="Order cancelled">
      <bpmn:incoming>flow_paymentOverdue</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_orderPlaced" sourceRef="startEvent_orderPlaced" targetRef="userTask_sendInvoice" />
    <bpmn:sequenceFlow id="flow_invoiceSent" sourceRef="userTask_sendInvoice" targetRef="gateway_paymentOutcome" />
    <bpmn:sequenceFlow id="flow_toPaymentReceived" sourceRef="gateway_paymentOutcome" targetRef="event_paymentReceived" />
    <bpmn:sequenceFlow id="flow_paymentReceived" sourceRef="event_paymentReceived" targetRef="endEvent_orderPaid" />
    <bpmn:sequenceFlow id="flow_toPaymentOverdue" sourceRef="gateway_paymentOutcome" targetRef="event_paymentOverdue" />
    <bpmn:sequenceFlow id="flow_paymentOverdue" sourceRef="event_paymentOverdue" targetRef="endEvent_orderCancelled" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="orderPayment">
      <bpmndi:BPMNShape id="startEvent_orderPlaced_di" bpmnElement="startEvent_orderPlaced">
        <dc:Bounds x="160" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="147" y="225" width="63" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="userTask_sendInvoice_di" bpmnElement="userTask_sendInvoice">
        <dc:Bounds x="250" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_paymentOutcome_di" bpmnElement="gateway_paymentOutcome">
        <dc:Bounds x="410" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="390" y="152" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_paymentReceived_di" bpmnElement="event_paymentReceived">
        <dc:Bounds x="532" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="507" y="225" width="86" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_orderPaid_di" bpmnElement="endEvent_orderPaid">
        <dc:Bounds x="702" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="694" y="225" width="53" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_paymentOverdue_di" bpmnElement="event_paymentOverdue">
        <dc:Bounds x="532" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="508" y="365" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_orderCancelled_di" bpmnElement="endEvent_orderCancelled">
        <dc:Bounds x="702" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="681" y="365" width="79" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_orderPlaced_di" bpmnElement="flow_orderPlaced">
        <di:waypoint x="196" y="200" />
        <di:waypoint x="250" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_invoiceSent_di" bpmnElement="flow_invoiceSent">
        <di:waypoint x="350" y="200" />
        <di:waypoint x="410" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_toPaymentReceived_di" bpmnElement="flow_toPaymentReceived">
        <di:waypoint x="460" y="200" />
        <di:waypoint x="532" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_paymentReceived_di" bpmnElement="flow_paymentReceived">
        <di:waypoint x="568" y="200" />
        <di:waypoint x="702" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_toPaymentOverdue_di" bpmnElement="flow_toPaymentOverdue">
        <di:waypoint x="435" y="225" />
        <di:waypoint x="435" y="340" />
        <di:waypoint x="532" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_paymentOverdue_di" bpmnElement="flow_paymentOverdue">
        <di:waypoint x="568" y="340" />
        <di:waypoint x="702" y="340" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
