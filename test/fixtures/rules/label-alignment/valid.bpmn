<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_OrderCheck" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="orderCheck" isExecutable="true">
    <bpmn:startEvent id="startEvent_orderReceived" name="Order received">
      <bpmn:outgoing>flow_orderReceived</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="userTask_checkOrder" name="Check order">
      <bpmn:incoming>flow_orderReceived</bpmn:incoming>
      <bpmn:outgoing>flow_checkToComplete</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_orderComplete" name="Order complete?">
      <bpmn:incoming>flow_checkToComplete</bpmn:incoming>
      <bpmn:outgoing>flow_complete</bpmn:outgoing>
      <bpmn:outgoing>flow_incomplete</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="userTask_shipOrder" name="Ship order">
      <bpmn:incoming>flow_complete</bpmn:incoming>
      <bpmn:outgoing>flow_orderShipped</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="endEvent_orderShipped" name="Order shipped">
      <bpmn:incoming>flow_orderShipped</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="userTask_requestMissingItems" name="Request missing items">
      <bpmn:incoming>flow_incomplete</bpmn:incoming>
      <bpmn:outgoing>flow_itemsRequested</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="endEvent_orderOnHold" name="Order on hold">
      <bpmn:incoming>flow_itemsRequested</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_orderReceived" sourceRef="startEvent_orderReceived" targetRef="userTask_checkOrder" />
    <bpmn:sequenceFlow id="flow_checkToComplete" sourceRef="userTask_checkOrder" targetRef="gateway_orderComplete" />
    <bpmn:sequenceFlow id="flow_complete" name="Yes" sourceRef="gateway_orderComplete" targetRef="userTask_shipOrder" />
    <bpmn:sequenceFlow id="flow_orderShipped" sourceRef="userTask_shipOrder" targetRef="endEvent_orderShipped" />
    <bpmn:sequenceFlow id="flow_incomplete" name="No" sourceRef="gateway_orderComplete" targetRef="userTask_requestMissingItems" />
    <bpmn:sequenceFlow id="flow_itemsRequested" sourceRef="userTask_requestMissingItems" targetRef="endEvent_orderOnHold" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="orderCheck">
      <bpmndi:BPMNShape id="startEvent_orderReceived_di" bpmnElement="startEvent_orderReceived">
        <dc:Bounds x="160" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="141" y="225" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="userTask_checkOrder_di" bpmnElement="userTask_checkOrder">
        <dc:Bounds x="260" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_orderComplete_di" bpmnElement="gateway_orderComplete" isMarkerVisible="true">
        <dc:Bounds x="420" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="480" y="193" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="userTask_shipOrder_di" bpmnElement="userTask_shipOrder">
        <dc:Bounds x="540" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_orderShipped_di" bpmnElement="endEvent_orderShipped">
        <dc:Bounds x="700" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="683" y="125" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="userTask_requestMissingItems_di" bpmnElement="userTask_requestMissingItems">
        <dc:Bounds x="540" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_orderOnHold_di" bpmnElement="endEvent_orderOnHold">
        <dc:Bounds x="700" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="684" y="325" width="68" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_orderReceived_di" bpmnElement="flow_orderReceived">
        <di:waypoint x="196" y="200" />
        <di:waypoint x="260" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_checkToComplete_di" bpmnElement="flow_checkToComplete">
        <di:waypoint x="360" y="200" />
        <di:waypoint x="420" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_complete_di" bpmnElement="flow_complete">
        <di:waypoint x="445" y="175" />
        <di:waypoint x="445" y="100" />
        <di:waypoint x="540" y="100" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="452" y="130" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_orderShipped_di" bpmnElement="flow_orderShipped">
        <di:waypoint x="640" y="100" />
        <di:waypoint x="700" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_incomplete_di" bpmnElement="flow_incomplete">
        <di:waypoint x="445" y="225" />
        <di:waypoint x="445" y="300" />
        <di:waypoint x="540" y="300" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="452" y="256" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_itemsRequested_di" bpmnElement="flow_itemsRequested">
        <di:waypoint x="640" y="300" />
        <di:waypoint x="700" y="300" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
