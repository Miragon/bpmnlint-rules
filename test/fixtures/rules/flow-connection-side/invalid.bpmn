<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ConnectionSide" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="orderApproval" isExecutable="true">
    <bpmn:startEvent id="startEvent_orderReceived" name="Order received">
      <bpmn:outgoing>flow_orderReceived</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="gateway_intake">
      <bpmn:incoming>flow_orderReceived</bpmn:incoming>
      <bpmn:incoming>flow_rework</bpmn:incoming>
      <bpmn:outgoing>flow_toReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="userTask_reviewOrder" name="Review order">
      <bpmn:incoming>flow_toReview</bpmn:incoming>
      <bpmn:outgoing>flow_toDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_approved" name="Approved?">
      <bpmn:incoming>flow_toDecision</bpmn:incoming>
      <bpmn:outgoing>flow_finalize</bpmn:outgoing>
      <bpmn:outgoing>flow_revise</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="userTask_finalizeOrder" name="Finalize order">
      <bpmn:incoming>flow_finalize</bpmn:incoming>
      <bpmn:outgoing>flow_done</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="endEvent_orderHandled" name="Order handled">
      <bpmn:incoming>flow_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="userTask_reviseOrder" name="Revise order">
      <bpmn:incoming>flow_revise</bpmn:incoming>
      <bpmn:outgoing>flow_rework</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_orderReceived" sourceRef="startEvent_orderReceived" targetRef="gateway_intake" />
    <bpmn:sequenceFlow id="flow_toReview" sourceRef="gateway_intake" targetRef="userTask_reviewOrder" />
    <bpmn:sequenceFlow id="flow_toDecision" sourceRef="userTask_reviewOrder" targetRef="gateway_approved" />
    <bpmn:sequenceFlow id="flow_finalize" name="yes" sourceRef="gateway_approved" targetRef="userTask_finalizeOrder" />
    <bpmn:sequenceFlow id="flow_done" sourceRef="userTask_finalizeOrder" targetRef="endEvent_orderHandled" />
    <bpmn:sequenceFlow id="flow_revise" name="no" sourceRef="gateway_approved" targetRef="userTask_reviseOrder" />
    <bpmn:sequenceFlow id="flow_rework" sourceRef="userTask_reviseOrder" targetRef="gateway_intake" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="orderApproval">
      <bpmndi:BPMNShape id="startEvent_orderReceived_di" bpmnElement="startEvent_orderReceived">
        <dc:Bounds x="160" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="146" y="225" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_intake_di" bpmnElement="gateway_intake" isMarkerVisible="true">
        <dc:Bounds x="250" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="userTask_reviewOrder_di" bpmnElement="userTask_reviewOrder">
        <dc:Bounds x="360" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_approved_di" bpmnElement="gateway_approved" isMarkerVisible="true">
        <dc:Bounds x="540" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="538" y="145" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="userTask_finalizeOrder_di" bpmnElement="userTask_finalizeOrder">
        <dc:Bounds x="660" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_orderHandled_di" bpmnElement="endEvent_orderHandled">
        <dc:Bounds x="840" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="822" y="225" width="71" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="userTask_reviseOrder_di" bpmnElement="userTask_reviseOrder">
        <dc:Bounds x="400" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_orderReceived_di" bpmnElement="flow_orderReceived">
        <di:waypoint x="196" y="200" />
        <di:waypoint x="250" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_toReview_di" bpmnElement="flow_toReview">
        <di:waypoint x="300" y="200" />
        <di:waypoint x="360" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_toDecision_di" bpmnElement="flow_toDecision">
        <di:waypoint x="460" y="200" />
        <di:waypoint x="552" y="187" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_finalize_di" bpmnElement="flow_finalize">
        <di:waypoint x="590" y="200" />
        <di:waypoint x="660" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="616" y="182" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_done_di" bpmnElement="flow_done">
        <di:waypoint x="760" y="200" />
        <di:waypoint x="840" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_revise_di" bpmnElement="flow_revise">
        <di:waypoint x="565" y="225" />
        <di:waypoint x="565" y="280" />
        <di:waypoint x="360" y="280" />
        <di:waypoint x="360" y="360" />
        <di:waypoint x="400" y="360" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="547" y="262" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_rework_di" bpmnElement="flow_rework">
        <di:waypoint x="400" y="360" />
        <di:waypoint x="320" y="360" />
        <di:waypoint x="320" y="260" />
        <di:waypoint x="275" y="260" />
        <di:waypoint x="275" y="225" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
