<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_c7_boundary_host" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="orderPayment" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="startEvent_orderReceived" name="Order received" camunda:asyncBefore="true">
      <bpmn:outgoing>flow_orderReceived</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="serviceTask_chargeCard" name="Charge card" camunda:asyncBefore="true" camunda:delegateExpression="${chargeCardDelegate}">
      <bpmn:incoming>flow_orderReceived</bpmn:incoming>
      <bpmn:outgoing>flow_cardCharged</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endEvent_orderPaid" name="Order paid">
      <bpmn:incoming>flow_cardCharged</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="event_refundCharge" name="Refund charge" attachedToRef="serviceTask_chargeCard">
      <bpmn:compensateEventDefinition id="compensateEventDefinition_refundCharge" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="serviceTask_refundCard" name="Refund card" isForCompensation="true" camunda:asyncBefore="true" camunda:delegateExpression="${refundCardDelegate}">
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_orderReceived" sourceRef="startEvent_orderReceived" targetRef="serviceTask_chargeCard" />
    <bpmn:sequenceFlow id="flow_cardCharged" sourceRef="serviceTask_chargeCard" targetRef="endEvent_orderPaid" />
    <bpmn:association id="association_refundCharge" sourceRef="event_refundCharge" targetRef="serviceTask_refundCard" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="orderPayment">
      <bpmndi:BPMNShape id="startEvent_orderReceived_di" bpmnElement="startEvent_orderReceived">
        <dc:Bounds x="160" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_chargeCard_di" bpmnElement="serviceTask_chargeCard">
        <dc:Bounds x="250" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_orderPaid_di" bpmnElement="endEvent_orderPaid">
        <dc:Bounds x="410" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_refundCharge_di" bpmnElement="event_refundCharge">
        <dc:Bounds x="282" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_refundCard_di" bpmnElement="serviceTask_refundCard">
        <dc:Bounds x="370" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_orderReceived_di" bpmnElement="flow_orderReceived">
        <di:waypoint x="196" y="120" />
        <di:waypoint x="250" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_cardCharged_di" bpmnElement="flow_cardCharged">
        <di:waypoint x="350" y="120" />
        <di:waypoint x="410" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="association_refundCharge_di" bpmnElement="association_refundCharge">
        <di:waypoint x="300" y="178" />
        <di:waypoint x="300" y="260" />
        <di:waypoint x="370" y="260" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
